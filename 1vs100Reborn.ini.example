; Copy as 1vs100Reborn.ini next to the launcher (looked up first) or to the HDD root.
; The launcher reads this file and hands the values to the sysdll.
; A missing key keeps the value shown here. An invalid value or unknown key refuses the launch;
; the log names it.

[backend]
; Required. IPv4 address or host name, at most 16 characters. A name is resolved through the
; console's DNS server; the launch is refused when it does not resolve.
host=192.168.1.10
sbg_port=1000
matchmaking_port=1001
; Massive in-game ad server, on the host above.
mads_port=1000

[log]
; off | debug | file | both. file: HDD, does not slow the game; debug: debug channel (XBDM).
sink=file
; error | warn | info | debug. Default: info in the production build, debug in the diagnostics
; build.
;level=info
; With sink=file, lines this severe or worse also go to the debug channel; none: no line.
debug_also=warn
; Below the HDD root. Files are run-000001.log, run-000002.log, ...; latest.txt names the newest.
dir=1vs100Reborn\logs
; Log files kept (1-1000).
keep=10
; RAM buffer in KB, a power of two (64-16384). A full buffer drops lines and says so in the file.
buffer_kb=2048
; Buffer to file interval (100-60000 ms).
flush_ms=100
; Tags to leave out (-tag) or to keep only (tag): e.g. -netlog,-tlog or qnet,mm,launcher.
; Tags: core title patch cave cfg mm qnet net content xam lua netlog launcher xulu tlog
;tags=

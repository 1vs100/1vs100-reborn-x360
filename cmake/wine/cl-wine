#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
. "$DIR/winepath-args.sh"
: "${XEDK:?cl-wine: set XEDK to the XDK root}"
export WINEPREFIX="${WINEPREFIX:-$HOME/.wine-xdk}"
export WINEDEBUG="${WINEDEBUG:--all}"
ensure_wineserver
translate_args "$@"
[ -n "${XEXWINE_WRAP_DEBUG:-}" ] && printf 'cl-wine: %s\n' "${TRANSLATED_ARGS[*]}" >&2
# /showIncludes lines name Wine paths (Z:\...); Ninja's msvc deps parser needs host paths.
run_wine_command wine "$XEDK/bin/win32/cl.exe" "${TRANSLATED_ARGS[@]}" | from_win_includes

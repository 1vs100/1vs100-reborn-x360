# yaml-language-server: $schema=https://json.schemastore.org/clangd.json
# Generated by CMake from cmake/clangd.in (XDK root from $XEDK); edit the template, not .clangd.
CompileFlags:
  CompilationDatabase: build
  Add:
    - "--include-directory=@XDK_ROOT@/include/xbox"
Diagnostics:
  MissingIncludes: Strict
  UnusedIncludes: Strict
